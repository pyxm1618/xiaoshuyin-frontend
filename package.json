{
  "name": "xiaoshuyin-frontend",
  "private": true,
  "type": "module",
  "engines": {"node": "26.13.0"},
  "packageManager": "bun@1.4.4",
  "scripts": {
    "authority:check": "node scripts/upstream.mjs authority",
    "contract:check": "node scripts/upstream.mjs contract",
    "contract:preview": "node scripts/upstream.mjs preview",
    "governance:check": "node scripts/governance.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --project tsconfig.json --noEmit",
    "test": "node --test tests/bootstrap.test.mjs",
    "test:app": "vitest run tests/fe-001",
    "verify-all": "node scripts/verify-all.mjs"
  },
  "devDependencies": {
    "miniprogram-api-typings": "5.3.1",
    "openapi-fetch": "0.17.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
